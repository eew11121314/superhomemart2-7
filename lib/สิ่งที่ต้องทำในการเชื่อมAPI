หน้า profile_m.dart  ต้องมีการเพิ่มฟังชั่นการเปลี่ยงแปลงข้อมูล
และทำการเพิ่มฟังชั่นการเปลี่ยนรหัสผ่าน   โดยมีการเชื่อมกับหน้า edit_profile_m.dart 


ใช้คำสั่งอันนี้ในการเซฟรูปแล้วรูปจะส่งไปยัง path ที่ตั้งไว้

fetch('/upload/image/path', {
      method: 'POST',
      body: formData
    })
    .then((res) => res.json())
    .then((data) => {
      if (data.message === "Upload successful") {
        alert("Profile picture updated successfully!");
        // อัปเดตภาพโปรไฟล์ใหม่
        const newImagePath = data.imagePath;
        document.querySelector(".profile__avatar img").src = newImagePath;
        localStorage.setItem('profileImage', newImagePath); // เก็บ URL ของภาพโปรไฟล์ใน localStorage
      } else {
        alert("Error uploading image: " + data.error);
      }
    })
    .catch((error) => {
      console.error("Error:", error);
      alert("An error occurred while uploading the image.");
    });
  } else {
    alert("Please select a file and make sure you are logged in.");
  }
});

